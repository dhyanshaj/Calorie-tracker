# Optional: enables image recognition with description context.
# The key stays on the server. Images are sent to OpenAI only on Analyze.
MEAL_VISION_API_KEY=
MEAL_VISION_MODEL=gpt-4.1-mini
# Optional: enables USDA FoodData Central search beyond the bundled SR28 foods.
USDA_API_KEY=
PORT=3000
# Optional. Default: .data/platewise.sqlite (relative to project root).
# DATABASE_PATH=/path/to/persistent/platewise.sqlite
# For Internet deployment set NODE_ENV=production behind HTTPS.
# Keep account data on a persistent, access-controlled server database.

# Optional: Plus INR 199/month or INR 1499/year after the 30-calendar-day trial.
# Create separate monthly/yearly plans and signed webhooks; see docs/PAYMENTS.md.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_ANNUAL_PLAN_ID=

# Optional email verification and password recovery via Resend (server only).
MAIL_API_KEY=
MAIL_FROM=
# Actual public HTTPS root URL for email links; see docs/LAUNCH.md.
APP_PUBLIC_URL=
# Domain hostname only, for the optional Caddy/Compose deployment.
APP_DOMAIN=
# Set to 1 only behind a single trusted proxy that is the sole route to Node.
# TRUST_PROXY_HOPS=1
# Optional backup destination, outside version control.
# BACKUP_DIR=.backups
